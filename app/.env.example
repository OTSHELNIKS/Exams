# Use the public/publishable key only. Never put a service_role or secret key here.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
# Public hCaptcha site key. Configure the same provider and secret in Supabase Auth.
VITE_HCAPTCHA_SITE_KEY=
# Keep false until secure Telegram migrations, functions and gateway are tested together.
VITE_TELEGRAM_SECURE_ENABLED=false
# Public username only; set a separate test bot on an isolated staging build.
VITE_TELEGRAM_BOT_USERNAME=name_mlbb_bot
